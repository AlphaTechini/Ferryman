# Copy to .env (git-ignored) and fill in. Every variable is optional except CL_POOL_MANAGER for token indexing.

# RPC endpoints and explorer API
ELYSIUM_RPC=https://testnet-rpc.elysium.kinetiq.xyz
HYPEREVM_RPC=https://rpc.hyperliquid-testnet.xyz/evm
EXPLORER_API=https://testnet-api.elysium.kinetiq.xyz/api/v2

# Signing. Leave empty to run read-only (API and indexing only, no claims, registrations or redeems).
KEEPER_PRIVATE_KEY=
# Simulate every transaction, send none.
DRY_RUN=false

# HTTP
LISTEN_ADDR=:8787

# Storage and deployed contracts
DATA_DIR=./data
DEPLOYMENTS=../deployments/testnet.json

# Ascend launchpad (pool hook) and CLPoolManager. CL_POOL_MANAGER has no default: the address is unverified.
LAUNCHPAD=0x6d01f6644bbf1b5074472D3e85aa1465B4d2bF3d
CL_POOL_MANAGER=

# Token indexing
INDEX_FROM_BLOCK=0
LOG_RANGE=5000
OUR_LAUNCHERS=
# Extra quote currencies beyond canonical USDC and the Ascend mock USDC (comma list).
QUOTE_CURRENCIES=

# Ferry Out
DEFAULT_CLAIM_TIP_WEI=500000000000000

# Rescue
RESCUE_ENABLED=true
RESCUE_MIN_AGE=24h
RESCUE_LOOKBACK=720h
RESCUE_MAX_PER_RUN=10

# Loops
POLL_INTERVAL=20s

# Logging
LOG_LEVEL=info
LOG_FORMAT=text
